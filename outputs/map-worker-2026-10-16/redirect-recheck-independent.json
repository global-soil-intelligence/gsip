    "workflow_source": {
      "returncode": 0,
      "data": {
        "path": ".github/workflows/pages.yml",
        "sha": "841d52544f4e50c2dd54f78d42f3226d5784458f",
        "ref": "main",
        "source": "name: Deploy GitHub Pages\n\non:\n  push:\n    branches: [main]\n  workflow_dispatch:\n\nconcurrency:\n  group: pages\n  cancel-in-progress: true\n\njobs:\n  build:\n    permissions:\n      contents: read\n    runs-on: ubuntu-latest\n    steps:\n      - uses: actions/checkout@v7\n      - uses: pnpm/action-setup@v6\n        with:\n          version: 11.9.0\n      - uses: actions/setup-node@v7\n        with:\n          node-version: 24\n          cache: pnpm\n      - run: pnpm install --frozen-lockfile\n      - run: pnpm build:pages\n        env:\n          VITE_SUPABASE_PUBLISHABLE_KEY: ${{ vars.VITE_SUPABASE_PUBLISHABLE_KEY }}\n          VITE_SUPABASE_URL: ${{ vars.SUPABASE_URL }}\n          VITE_PRIOR_TILES_BASE: ${{ vars.VITE_PRIOR_TILES_BASE }}\n          VITE_CAPTURE_LIVE: 'false'\n          VITE_LIBRARY_INTAKE_LIVE: 'false'\n          VITE_DATASET_URL: ${{ vars.VITE_DATASET_URL }}\n          # The deployed gsip-public function; unset until it answers (WP-AGENT-1).\n          VITE_GSIP_PUBLIC_API: ${{ vars.VITE_GSIP_PUBLIC_API }}\n          VITE_TERMS_URL: ${{ vars.VITE_TERMS_URL }}\n          VITE_PRIVACY_URL: ${{ vars.VITE_PRIVACY_URL }}\n          VITE_SAMPLING_RULES_URL: ${{ vars.VITE_SAMPLING_RULES_URL }}\n      - run: pnpm check:map-budget\n      # A legend must never disagree with its tiles: the archives for this palette version must\n      # exist and carry its stamp before the map that draws those legends is deployed.\n      - run: pnpm check:prior-tiles\n        env:\n          VITE_PRIOR_TILES_BASE: ${{ vars.VITE_PRIOR_TILES_BASE }}\n      - run: pnpm check:site-budget\n      - uses: actions/configure-pages@v6\n      - uses: actions/upload-pages-artifact@v5\n        with:\n          path: _site\n  deploy:\n    environment:\n      name: github-pages\n      url: ${{ steps.deployment.outputs.page_url }}\n    needs: build\n    permissions:\n      pages: write\n      id-token: write\n    runs-on: ubuntu-latest\n    steps:\n      - id: deployment\n        uses: actions/deploy-pages@v5\n"
      },
      "stderr": ""
    }
