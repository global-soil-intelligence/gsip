+          bytes: new Uint8Array([1, 2]),
+          mimeType: 'image/jpeg',
+          method: 'file',
+        },
+      })
+    if (version >= 3) {
+      await legacy.put(
+        'libraryDraft',
+        { syntheticMarker: 'legacy-library-draft' },
+        'current',
+      )
+      await legacy.put(
+        'libraryNamespace',
+        { nodeId: 'fictional-node', ownerUid: 'fictional-owner' },
