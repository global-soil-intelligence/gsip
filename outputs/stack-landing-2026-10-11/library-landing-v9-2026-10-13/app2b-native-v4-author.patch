+        else "iOS unsigned simulator; signing disabled"
+    )
+    if value["comparison_scope"] != expected_scope:
+        refuse()
+    locks = value["lockfile_sha256"]
+    if not isinstance(locks, dict):
+        refuse()
+    lock_names = {"pnpm-lock.yaml", "uv.lock"}
+    if target == "android":
