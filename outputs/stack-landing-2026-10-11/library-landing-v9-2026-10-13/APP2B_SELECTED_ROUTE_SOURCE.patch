+def test_gmm_exact_six_primary_contexts_and_logical_filename_roles() -> None:
+    docs = primary_gmm_documents()
+    assert len(docs) == len(audit.GMM_CONTEXTS) == 6
+    assert audit.GMM_REDIRECTS == GMM_TEST_ROUTES
+    for key, raw in docs.items():
+        assert (audit.sha(raw.encode()), len(raw.encode())) == audit.GMM_CONTEXTS[
+            audit.coordinate(key.split(":"))
+        ]
+    graphic = json.loads(docs["androidx.graphics:graphics-shapes-android:1.0.1"])
+    row = next(v for v in graphic["variants"] if v["name"] == "releaseRuntimeElements-published")
+    assert row["files"][0]["name"] == "graphics-shapes-release.aar"
+    assert row["files"][0]["url"] == "graphics-shapes-android-1.0.1.aar"
