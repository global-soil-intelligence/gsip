+        for v in view["selected_modules"]
+        if v["coordinate"] == ["androidx.graphics", "graphics-shapes", "1.0.1"]
+    )
+    proof = row["selected_variant_redirect"]
+    node = proof["module_metadata"][0 if role == "source_url" else 1]
+    raw = base64.b64decode(node["content_base64"])
+    document = json.loads(raw)
+    selected = next(
+        v for v in document["variants"] if v["name"] == "releaseRuntimeElements-published"
+    )
+    if role == "source_url":
