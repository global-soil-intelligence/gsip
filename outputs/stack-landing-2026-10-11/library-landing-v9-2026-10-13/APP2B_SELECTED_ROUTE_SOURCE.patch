+        "debug_signing_key_sha256": "c" * 64,
+        "runtime_tree_sha256": {
+            "debugRuntimeClasspath": "d" * 64,
+            "releaseRuntimeClasspath": "e" * 64,
+        },
+    }
+    return native, {row["name"]: row for row in result["npm_sources"]}
