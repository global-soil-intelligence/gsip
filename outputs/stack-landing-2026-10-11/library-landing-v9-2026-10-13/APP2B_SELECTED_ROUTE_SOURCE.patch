+def repeated_runtime_fixture(
+    graph: tuple[dict[str, Any], Path, Path, Path],
+    kind: str,
+    monkeypatch: pytest.MonkeyPatch,
+) -> tuple[dict[str, Any], Path, Path, Path]:
+    data, repo, cache, module_artifact = graph
+    package = repo / "node_modules/@capacitor/camera"
+    project_artifact = package / "android/build/intermediates/classes/debug/classes.jar"
+    zipped(project_artifact)
+    link = repo / "apps/capture-pwa/node_modules/@capacitor/camera"
+    link.parent.mkdir(parents=True)
+    link.symlink_to(package, target_is_directory=True)
+    monkeypatch.setattr(
+        audit,
+        "npm_evidence",
+        lambda *_args: [
+            {"name": "@capacitor/camera", "installed_source_manifest_sha256": "a" * 64}
+        ],
+    )
+    for view in data["views"]:
+        view["projects"].append(":capacitor-camera")
+        project = {"kind": "project", "project": ":capacitor-camera", "file": str(project_artifact)}
+        if kind == "project":
+            view["artifacts"].append(project)
+        else:
+            view["artifacts"].insert(0, project)
+    return data, repo, cache, project_artifact if kind == "project" else module_artifact
+
