+def gmm_graph(
+    graph: tuple[dict[str, Any], Path, Path, Path], monkeypatch: pytest.MonkeyPatch
+) -> tuple[dict[str, Any], Path, Path]:
+    data, repo, cache, _ = repeated_runtime_fixture(graph, "module", monkeypatch)
+    docs = primary_gmm_documents()
+    contexts = dict(
+        getattr(
+            audit,
+            "GMM_CONTEXTS",
+            {
+                audit.coordinate(key.split(":")): (audit.sha(text.encode()), len(text.encode()))
+                for key, text in docs.items()
+            },
+        )
+    )
+    redirects = []
+    for source, (target, variant, filename, _location) in GMM_TEST_ROUTES.items():
+        binary = (
+            cache
+            / "modules-2/files-2.1"
+            / target[0]
+            / target[1]
+            / target[2]
+            / "synthetic-binary"
+            / filename
+        )
+        zipped(binary, b"synthetic routed binary fixture")
+        document = json.loads(docs[":".join(target)])
+        terminal = next(v for v in document["variants"] if v["name"] == variant)["files"][0]
+        terminal["sha256"], terminal["size"] = audit.sha(binary.read_bytes()), binary.stat().st_size
+        docs[":".join(target)] = json.dumps(document, sort_keys=True)
+        raw = docs[":".join(target)].encode()
+        contexts[target] = (audit.sha(raw), len(raw))
+        for coord in (source, target):
+            cached(cache, coord, pom(coord))
+        for view in data["views"]:
+            view["modules"].extend([list(source), list(target)])
+            view["artifacts"].append(
+                {"kind": "module", "coordinate": list(target), "file": str(binary)}
+            )
+        redirects.append(
+            {
+                "source": list(source),
+                "variant": variant,
+                "target": list(target),
+                "target_variant": variant,
+            }
+        )
+    for key, text in docs.items():
+        group, module, version = key.split(":")
+        path = cache / "modules-2/files-2.1" / group / module / version / "synthetic-metadata"
+        path.mkdir(parents=True, exist_ok=True)
+        (path / f"{module}-{version}.module").write_text(text)
+    monkeypatch.setattr(audit, "GMM_CONTEXTS", contexts, raising=False)
+    for view in data["views"]:
+        view["redirects"] = copy.deepcopy(redirects)
+    return data, repo, cache
