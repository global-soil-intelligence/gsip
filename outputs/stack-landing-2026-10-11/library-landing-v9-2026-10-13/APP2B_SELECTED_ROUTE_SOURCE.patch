+def test_gmm_selected_routes_retain_all_poms_binaries_and_validate_offline(
+    gmm_graph: tuple[dict[str, Any], Path, Path],
+) -> None:
+    data, repo, cache = gmm_graph
+    result = audit.runtime_evidence(data, repo, cache, False)
+    native, npm = runtime_validator_fixture(result)
+    audit.validate_android(native, npm)
+    for index, view in enumerate(result["runtime_views"]):
+        assert len(view["selected_modules"]) == 7
+        assert len(view["resolved_runtime_inputs"]) == 5
+        assert len(data["views"][index]["artifacts"]) == 5
+        routed = [v for v in view["selected_modules"] if "selected_variant_redirect" in v]
+        assert len(routed) == 3
+        for row in routed:
+            assert row["pom_license_evidence"]
+            proof = row["selected_variant_redirect"]
+            assert len(proof["module_metadata"]) == 2
+            assert proof["module_metadata"][0]["coordinate"] == row["coordinate"]
+            assert proof["module_metadata"][1]["coordinate"] == proof["target"]
+    assert "synthetic-metadata" not in json.dumps(result)
+    assert str(cache) not in json.dumps(result)
