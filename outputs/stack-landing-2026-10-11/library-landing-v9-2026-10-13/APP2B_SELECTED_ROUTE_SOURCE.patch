+    else:
+        selected["files"][0]["name" if role == "logical_name" else "url"] = "incorrect.aar"
+    raw = json.dumps(document, sort_keys=True).encode()
+    node.update(
+        {
+            "content_base64": base64.b64encode(raw).decode(),
+            "bytes": len(raw),
+            "sha256": audit.sha(raw),
+        }
+    )
+    contexts = dict(audit.GMM_CONTEXTS)
+    contexts[tuple(node["coordinate"])] = (audit.sha(raw), len(raw))
+    monkeypatch.setattr(audit, "GMM_CONTEXTS", contexts)
+    with pytest.raises(audit.AuditError):
+        audit.validate_gmm_redirect(
+            tuple(row["coordinate"]),
+            proof,
+            {tuple(v["coordinate"]) for v in view["selected_modules"]},
+            view["resolved_runtime_inputs"],
+        )
