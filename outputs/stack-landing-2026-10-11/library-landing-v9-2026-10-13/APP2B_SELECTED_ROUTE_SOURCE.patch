+@pytest.mark.parametrize(
+    "defect",
+    [
+        "missing",
+        "empty",
+        "duplicate",
+        "unknown_source",
+        "wrong_variant",
+        "wrong_target_variant",
+        "cycle",
+        "closed_target",
+        "unselected_target",
+        "source_missing",
+        "private_extra",
+        "metadata_missing",
+        "metadata_ambiguous",
+        "metadata_symlink",
+        "metadata_hardlink",
+        "metadata_fifo",
+        "metadata_oversize",
+        "metadata_corrupt",
+        "pretend_direct_root_binary",
+    ],
+)
+def test_gmm_producer_refuses_unverified_route_or_metadata(
+    gmm_graph: tuple[dict[str, Any], Path, Path], defect: str
+) -> None:
+    data, repo, cache = gmm_graph
+    view = data["views"][0]
+    route = view["redirects"][0]
+    source, target = audit.coordinate(route["source"]), audit.coordinate(route["target"])
+    metadata = next(
+        (cache / "modules-2/files-2.1" / source[0] / source[1] / source[2]).glob("*/*.module")
+    )
+    if defect in {"missing", "pretend_direct_root_binary"}:
+        view["redirects"].pop(0)
+        if defect == "pretend_direct_root_binary":
+            file = metadata.parent / "pretend-direct.jar"
+            zipped(file)
+            view["artifacts"].append(
+                {"kind": "module", "coordinate": list(source), "file": str(file)}
+            )
+    elif defect == "empty":
+        view["redirects"] = []
+    elif defect == "duplicate":
+        view["redirects"][1] = copy.deepcopy(route)
+    elif defect == "unknown_source":
+        route["source"] = list(COORD)
+    elif defect == "wrong_variant":
+        route["variant"] = "jvmApiElements-published"
+    elif defect == "wrong_target_variant":
+        route["target_variant"] = "jvmApiElements-published"
+    elif defect == "cycle":
+        route["target"] = list(source)
+    elif defect == "closed_target":
+        route["target"] = ["com.google.android.gms", "play-services-location", "1.0"]
+    elif defect in {"source_missing", "unselected_target"}:
+        absent = list(source if defect == "source_missing" else target)
+        view["modules"].remove(absent)
+        view["artifacts"] = [a for a in view["artifacts"] if a.get("coordinate") != absent]
+    elif defect == "private_extra":
+        route["private"] = "synthetic private sentinel"
+    elif defect == "metadata_missing":
+        metadata.unlink()
+    elif defect == "metadata_ambiguous":
+        second = metadata.parent.parent / "another" / metadata.name
+        second.parent.mkdir()
+        second.write_bytes(metadata.read_bytes())
+    elif defect in {"metadata_symlink", "metadata_hardlink", "metadata_fifo"}:
+        saved = metadata.with_name("saved.module")
+        saved.write_bytes(metadata.read_bytes())
+        metadata.unlink()
+        if defect == "metadata_symlink":
+            metadata.symlink_to(saved)
+        elif defect == "metadata_hardlink":
+            os.link(saved, metadata)
+        else:
+            os.mkfifo(metadata)
+    elif defect == "metadata_oversize":
+        metadata.write_bytes(b" " * (audit.MAX_GMM_BYTES + 1))
+    else:
+        metadata.write_bytes(metadata.read_bytes() + b" ")
+    with pytest.raises(audit.AuditError):
+        audit.runtime_evidence(data, repo, cache, False)
