+@pytest.mark.parametrize(
+    "defect",
+    [
+        "proof_missing",
+        "proof_empty",
+        "target_unknown",
+        "variant",
+        "target_variant",
+        "doc_missing",
+        "doc_extra",
+        "doc_order",
+        "raw_private",
+        "base64",
+        "base64_oversize",
+        "doc_size_bool",
+        "doc_size_wrong",
+        "doc_sha",
+        "doc_coordinate",
+        "doc_extra_field",
+        "proof_extra",
+        "target_binary_missing",
+        "target_binary_digest",
+        "target_binary_size",
+        "target_binary_name",
+        "pretend_direct_root_binary",
+    ],
+)
+def test_gmm_offline_validator_refuses_missing_tampered_or_unbound_route(
+    gmm_graph: tuple[dict[str, Any], Path, Path], defect: str
+) -> None:
+    data, repo, cache = gmm_graph
+    result = audit.runtime_evidence(data, repo, cache, False)
+    native, npm = runtime_validator_fixture(result)
+    audit.validate_android(native, npm)
+    view = native["runtime_views"][0]
+    # JSON coordinates are lists, not tuples.
+    row = next(
+        v for v in view["selected_modules"] if tuple(v["coordinate"]) == list(GMM_TEST_ROUTES)[0]
+    )
+    proof = row["selected_variant_redirect"]
+    doc = proof["module_metadata"][0]
+    target_binary = next(
+        v for v in view["resolved_runtime_inputs"] if v.get("coordinate") == proof["target"]
+    )
+    if defect in {"proof_missing", "pretend_direct_root_binary"}:
+        del row["selected_variant_redirect"]
+        if defect == "pretend_direct_root_binary":
+            extra = copy.deepcopy(target_binary)
+            extra["coordinate"] = row["coordinate"]
+            extra["filename"] = "pretend-direct.jar"
+            view["resolved_runtime_inputs"].append(extra)
+    elif defect == "proof_empty":
+        row["selected_variant_redirect"] = {}
+    elif defect == "target_unknown":
+        proof["target"] = list(COORD)
+    elif defect in {"variant", "target_variant"}:
+        proof[defect] = "synthetic-private-variant"
+    elif defect == "doc_missing":
+        proof["module_metadata"].pop()
+    elif defect == "doc_extra":
+        proof["module_metadata"].append(copy.deepcopy(doc))
+    elif defect == "doc_order":
+        proof["module_metadata"].reverse()
+    elif defect == "raw_private":
+        doc["content_base64"] = "synthetic private sentinel"
+    elif defect == "base64":
+        doc["content_base64"] = "%%"
+    elif defect == "base64_oversize":
+        doc["content_base64"] = "A" * (audit.MAX_GMM_BYTES * 2)
+    elif defect == "doc_size_bool":
+        doc["bytes"] = True
+    elif defect == "doc_size_wrong":
+        doc["bytes"] += 1
+    elif defect == "doc_sha":
+        doc["sha256"] = "f" * 64
+    elif defect == "doc_coordinate":
+        doc["coordinate"] = list(COORD)
+    elif defect == "doc_extra_field":
+        doc["private"] = "synthetic private sentinel"
+    elif defect == "proof_extra":
+        proof["private"] = "synthetic private sentinel"
+    elif defect == "target_binary_missing":
+        view["resolved_runtime_inputs"].remove(target_binary)
+    elif defect == "target_binary_digest":
+        target_binary["sha256"] = "f" * 64
+    elif defect == "target_binary_size":
+        target_binary["bytes"] += 1
+    else:
+        target_binary["filename"] = "wrong-logical-name.jar"
+    with pytest.raises((audit.AuditError, ValueError)):
+        audit.validate_android(native, npm)
