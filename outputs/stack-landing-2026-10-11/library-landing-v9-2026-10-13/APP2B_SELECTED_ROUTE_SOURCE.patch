+def test_gmm_public_fetch_is_fixed_and_missing_unknown_or_redirected_context_refuses(
+    tmp_path: Path, monkeypatch: pytest.MonkeyPatch
+) -> None:
+    docs = primary_gmm_documents()
+    coord = ("androidx.annotation", "annotation", "1.8.1")
+    calls: list[tuple[str, int]] = []
+
+    def fetch(url: str, limit: int) -> bytes:
+        calls.append((url, limit))
+        return docs[":".join(coord)].encode()
+
+    monkeypatch.setattr(audit, "public_bytes", fetch)
+    value = audit.gmm_document(coord, tmp_path, True)
+    audit.validate_gmm_document(value)
+    assert calls == [
+        (
+            "https://dl.google.com/dl/android/maven2/androidx/annotation/annotation/1.8.1/annotation-1.8.1.module",
+            audit.MAX_GMM_BYTES,
+        )
+    ]
+    with pytest.raises(audit.AuditError):
+        audit.gmm_document(COORD, tmp_path, True)
+    assert len(calls) == 1
+    with pytest.raises(audit.AuditError):
+        audit.gmm_document(coord, tmp_path, False)
