+def test_runtime_duplicate_same_canonical_file_is_reaudited_then_recorded_once(
+    graph: tuple[dict[str, Any], Path, Path, Path],
+    kind: str,
+    views: list[int],
+    copies: int,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    data, repo, cache, artifact = repeated_runtime_fixture(graph, kind, monkeypatch)
+    expected = audit.runtime_evidence(data, repo, cache, False)
+    real_zip = audit.zip_evidence
+    seen: list[Path] = []
+
+    def inspected(file: Path, roots: tuple[Path, ...]) -> dict[str, Any]:
+        value = real_zip(file, roots)
+        seen.append(file)
+        return value
+
+    monkeypatch.setattr(audit, "zip_evidence", inspected)
+    for index in views:
+        row = data["views"][index]["artifacts"][-1]
+        data["views"][index]["artifacts"].extend(copy.deepcopy(row) for _ in range(copies - 1))
+    actual = audit.runtime_evidence(data, repo, cache, False)
+    assert actual == expected
+    assert seen.count(artifact.resolve()) == 2 + len(views) * (copies - 1)
+    native, npm = runtime_validator_fixture(actual)
