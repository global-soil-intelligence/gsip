+        payload | {"measurement": payload["measurement"] | {"source_sha256": "f" * 64}},
+    ]:
+        with pytest.raises(ValueError, match="^Node exchange conflict$"):
+            bind(declare(event_id=uuid(58), payload=changed), [binding])
