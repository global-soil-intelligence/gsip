+def test_immutable_event_and_slot_ownership() -> None:
+    first = slot(prepare(RAW.encode()))
+    changes: list[dict[str, Any]] = [
+        dict(event_id=uuid(50)),
+        dict(scope_id=uuid(51)),
+        dict(source_peer_id=uuid(52)),
