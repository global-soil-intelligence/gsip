+@pytest.mark.parametrize("kind", ["module", "project"])
+@pytest.mark.parametrize("defect", ["changed_bytes", "changed_notices", "changed_size"])
+def test_runtime_duplicate_same_file_refuses_changed_complete_evidence(
+    graph: tuple[dict[str, Any], Path, Path, Path],
+    kind: str,
+    defect: str,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    data, repo, cache, artifact = repeated_runtime_fixture(graph, kind, monkeypatch)
+    data["views"][0]["artifacts"].append(copy.deepcopy(data["views"][0]["artifacts"][-1]))
+    real_zip = audit.zip_evidence
+    hits = 0
+
+    def changing(file: Path, roots: tuple[Path, ...]) -> dict[str, Any]:
+        nonlocal hits
+        value = real_zip(file, roots)
+        if file == artifact.resolve():
+            hits += 1
+            if hits == 1 and defect == "changed_bytes":
+                zipped(file, b"synthetic replacement bytes between observations")
+            elif hits == 2 and defect == "changed_notices":
+                value["embedded_license_notice_files"][0]["sha256"] = "f" * 64
+            elif hits == 2 and defect == "changed_size":
+                value["bytes"] += 1
+        return value
+
+    monkeypatch.setattr(audit, "zip_evidence", changing)
+    with pytest.raises(audit.AuditError):
+        audit.runtime_evidence(data, repo, cache, False)
+    assert hits == 2
