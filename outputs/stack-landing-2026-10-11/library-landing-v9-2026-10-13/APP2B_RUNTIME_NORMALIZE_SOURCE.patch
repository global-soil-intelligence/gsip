+@pytest.mark.parametrize("kind", ["module", "project"])
+@pytest.mark.parametrize("defect", ["bad_zip", "symlink", "hardlink", "fifo"])
+def test_runtime_duplicate_second_occurrence_cannot_skip_original_safety_checks(
+    graph: tuple[dict[str, Any], Path, Path, Path],
+    kind: str,
+    defect: str,
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    data, repo, cache, artifact = repeated_runtime_fixture(graph, kind, monkeypatch)
+    data["views"][0]["artifacts"].append(copy.deepcopy(data["views"][0]["artifacts"][-1]))
+    real_zip = audit.zip_evidence
+    hits = 0
+
+    def becomes_unsafe(file: Path, roots: tuple[Path, ...]) -> dict[str, Any]:
+        nonlocal hits
+        value = real_zip(file, roots)
+        if file == artifact.resolve():
+            hits += 1
+            if hits == 1:
+                if defect == "bad_zip":
+                    file.write_bytes(b"not a ZIP")
+                else:
+                    saved = file.with_name("synthetic-backup.jar")
+                    saved.write_bytes(file.read_bytes())
+                    if defect == "hardlink":
+                        os.link(file, file.with_name("synthetic-linked.jar"))
+                    else:
+                        file.unlink()
+                        if defect == "symlink":
+                            file.symlink_to(saved)
+                        else:
+                            os.mkfifo(file)
+        return value
+
+    monkeypatch.setattr(audit, "zip_evidence", becomes_unsafe)
+    with pytest.raises((audit.AuditError, zipfile.BadZipFile)):
+        audit.runtime_evidence(data, repo, cache, False)
+    assert hits == 1
