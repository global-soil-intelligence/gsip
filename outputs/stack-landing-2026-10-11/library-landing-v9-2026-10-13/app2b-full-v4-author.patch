+      const ownerChanged = previous.owner !== decision.owner
+      const changed =
+        ownerChanged ||
+        previous.revision !== decision.revision ||
+        previous.cycleOpen !== decision.hasWork ||
+        previous.allowed !== allowed(decision) ||
+        previous.blocked !== decision.blocked
