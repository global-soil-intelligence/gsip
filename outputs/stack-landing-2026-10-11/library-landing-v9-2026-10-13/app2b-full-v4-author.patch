+  owner: string | null
+  captureLive: boolean
+  gate: 'open' | 'closed' | 'unknown'
+  revision: number
+  hasWork: boolean
+  blocked: boolean
+}
+/** Private intent only; never store a session/token, queue record, photo or point here. */
+export type SyncReminderState = {
+  owner: string | null
+  enabled: boolean
+  epoch: number
+  revision: number
+  cycleOpen: boolean
+  consumed: boolean
+  allowed: boolean
+  blocked: boolean
+  cleanupPending: boolean
+}
+export const initialReminderState = (): SyncReminderState => ({
+  owner: null,
+  enabled: false,
+  epoch: 0,
+  revision: 0,
+  cycleOpen: false,
+  consumed: false,
+  allowed: false,
+  blocked: true,
+  cleanupPending: true,
+})
+export type ReminderStore = {
+  read(): Promise<SyncReminderState>
+  update(
+    change: (state: SyncReminderState) => SyncReminderState,
+  ): Promise<SyncReminderState>
+}
+export type ReminderOutcome =
+  | 'off'
+  | 'on'
+  | 'held'
+  | 'unsupported'
+  | 'permission_denied'
+  | 'cleanup_pending'
