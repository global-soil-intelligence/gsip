+    count = MAX_RETAINED_BYTES // MAX_BLOB_BYTES
+    for number in range(count):
+        identity = str(UUID(int=number + 100))
+        path = store.root / "blobs" / identity
+        path.write_bytes(content)
+        path.chmod(0o600)
+        image["blobs"][identity] = {
