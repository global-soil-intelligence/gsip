+    for path in (store.root, store.root / "blobs", store.root / "staging"):
+        assert stat.S_IMODE(path.stat().st_mode) == 0o700
+    for path in (store.root / ".lock", store.root / "state.json", store.root / "blobs" / _FIRST):
+        info = path.stat()
