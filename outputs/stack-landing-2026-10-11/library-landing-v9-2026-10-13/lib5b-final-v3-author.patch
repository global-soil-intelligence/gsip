+
+    def attack(point: str) -> None:
+        nonlocal changed, calls
+        if point != "file_after_read":
+            return
+        calls += 1
+        if calls != target_call:
+            return
+        changed = True
+        if race == "root_mode":
+            store.root.chmod(0o755)
+        elif race == "allowed_mode":
+            allowed.chmod(0o755)
+        elif race == "root_name":
