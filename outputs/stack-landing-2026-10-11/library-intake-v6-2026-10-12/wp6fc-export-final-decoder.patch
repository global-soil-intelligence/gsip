+            result,
+            fixtures.EXPORT_DATE,
+            "fixture",
+            "synthetic/example",
+            Hub(),  # type: ignore[arg-type]
+        )
+    finally:
+        source.client.close()
+    assert withdrawn and published.rows == 0 and published.photos == 0
