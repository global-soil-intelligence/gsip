{
  "name": "gsip",
  "version": "0.1.0",
  "private": true,
  "description": "Open soil spectral reference library in development",
  "license": "MIT",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "pnpm -r build",
    "build:pages": "pnpm build && node scripts/build-pages.mjs",
    "check:map-budget": "node scripts/check-map-budget.mjs",
    "check:prior-tiles": "pnpm --filter @gsip/map-web check:prior-tiles",
    "check:site-budget": "node scripts/check-site-budget.mjs",
    "db:reset": "supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "format": "prettier --write .",
    "lint": "eslint . && node scripts/check-language.mjs && prettier --check .",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.13.0",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vitest": "4.1.12"
  }
}
